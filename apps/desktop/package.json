{
  "name": "desktop",
  "version": "0.0.7",
  "private": true,
  "description": "Lomra desktop app",
  "author": "Lomra",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "bun test",
    "build:web": "bun run --cwd ../frontend build",
    "pack": "bun run build:web && electron-builder --dir",
    "dist": "bun run build:web && electron-builder"
  },
  "devDependencies": {
    "electron": "^45",
    "electron-builder": "^26.18.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "electron"
  ],
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@lydell/node-pty": "^1.2.0-beta.18"
  },
  "build": {
    "appId": "app.lomra.desktop",
    "productName": "Lomra",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@lydell/**",
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.test.mjs",
      "!node_modules/onnxruntime-web/**"
    ],
    "extraResources": [
      { "from": "../../LICENSE", "to": "LICENSE-Lomra.txt" },
      { "from": "../../NOTICE", "to": "NOTICE-Lomra.txt" },
      {
        "from": "../frontend/.next/standalone",
        "to": "web"
      },
      {
        "from": "../frontend/.next/static",
        "to": "web/.next/static"
      }
    ],
    "nsis": { "artifactName": "Lomra-${version}-windows-${arch}.${ext}" },
    "win": {
      "target": "nsis",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
        "!scripts/check-signature.*"
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.graphics-design",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**"
      ]
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
