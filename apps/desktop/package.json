{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Lomra desktop app",
  "author": "Lomra",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "bun test",
    "build:web": "bun run --cwd ../frontend build",
    "pack": "bun run build:web && electron-builder --dir",
    "dist": "bun run build:web && electron-builder"
  },
  "devDependencies": {
    "electron": "^45",
    "electron-builder": "^26.18.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "electron"
  ],
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18"
  },
  "build": {
    "appId": "app.lomra.desktop",
    "productName": "Lomra",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@lydell/**"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.test.mjs"
    ],
    "extraResources": [
      {
        "from": "../frontend/.next/standalone",
        "to": "web"
      },
      {
        "from": "../frontend/.next/static",
        "to": "web/.next/static"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
